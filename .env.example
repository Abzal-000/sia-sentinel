# НЕ копируйте заглушки ниже — сгенерируйте настоящие значения:
#   openssl rand -hex 32   (или python -c "import secrets; print(secrets.token_hex(32))")
# Заглушка в .env выглядит как валидный секрет, но любой читатель примера
# выводит из неё тот же ключ и подделывает подписи бесшумно.
EVIDENCE_SIGNING_KEY=
RECEIPT_SIGNING_KEY=
NVIDIA_API_KEY=
LOG_LEVEL=INFO
GITHUB_TOKEN=your-github-personal-access-token-here
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# Agent Identity (DID/VC)
IDENTITIES_DIR=identities
# === Redis Cache ===
REDIS_URL=redis://localhost:6379/0
