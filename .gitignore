*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# ZCode session artifacts
.zcode/

# Logs and data
logs/
evidence/
*.log

# Databases
*.db
*.sqlite
*.sqlite3

# Runtime data (tenants, usage meter, API keys, invoices, webhooks)
tenants.json
usage_events.jsonl
api_keys.json
invoices.json
webhooks.json
# Ledger history IS the product: the chain, its checkpoints and anchor files
# are trust-bearing state and live in git (second point of existence).
# Lock files and anything else in receipts/ stay out.
receipts/*
!receipts/registry.jsonl
!receipts/checkpoints.jsonl

# Anchored checkpoints: signed anchor files are trust-bearing history too
anchors/*
!anchors/*.json

# Environment variables
.env
.env.local
.env.production

# Testing
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak
backup_*/

# Agent identities and credentials (contains private keys)
identities/
demo_identities/
credentials/
demo_credentials/

# Generated audit/benchmark artifacts
artifacts/*
!artifacts/record1/
!artifacts/demo-live/

# Anchored checkpoints: signed anchor files are trust-bearing history too
# (whitelisted above; anchors/ line that was here previously overrode it)

# Prod bind-mount runtime state (compose ./data)
data/

# Downloaded datasets for beacon preparation (e.g. GSM8K)
.cache/

# Archived pre-isolation runtime state (do not publish)
receipts_stale_*/
evidence_stale_*/
